FROM alpine:latest

# Pull from Alpine edge so the MkDocs/Material toolchain is current.
RUN echo https://dl-cdn.alpinelinux.org/alpine/edge/main/      >  /etc/apk/repositories
RUN echo https://dl-cdn.alpinelinux.org/alpine/edge/community/ >> /etc/apk/repositories
RUN echo https://dl-cdn.alpinelinux.org/alpine/edge/testing/   >> /etc/apk/repositories

RUN apk update && apk upgrade
RUN apk add --no-cache build-base cmake python3 py3-pip py3-virtualenv git

COPY . /flatcompose
WORKDIR /flatcompose

# MkDocs + Material + the plugin set the docs rely on, isolated in a venv.
# The footer-tags plugin renders a "Related pages" block from shared tags
RUN python3 -m venv /flatcompose/docs/mkdocs/env && \
    /flatcompose/docs/mkdocs/env/bin/python3 -m ensurepip --upgrade && \
    /flatcompose/docs/mkdocs/env/bin/python3 -m pip install --upgrade pip && \
    /flatcompose/docs/mkdocs/env/bin/python3 -m pip install \
        mkdocs mkdocs-material mkdocs-mermaid2-plugin \
        mkdocs-panzoom-plugin mkdocs-drawio mkdocs-macros-plugin \
        git+https://github.com/ruanformigoni/mkdocs-material-footer-tags.git@v0.1.0

# Repo/release URLs surfaced in the docs
ARG FLATCOMPOSE_REPO_URL
ARG FLATCOMPOSE_RELEASE_URL
ENV FLATCOMPOSE_REPO_URL=$FLATCOMPOSE_REPO_URL
ENV FLATCOMPOSE_RELEASE_URL=$FLATCOMPOSE_RELEASE_URL

# The coverage ledger is authored in tests/
RUN cp /flatcompose/tests/README.md /flatcompose/docs/mkdocs/docs/tests.md

# One-shot build into docs/mkdocs/site
RUN cd /flatcompose/docs/mkdocs && \
    /flatcompose/docs/mkdocs/env/bin/mkdocs build

RUN mv /flatcompose/docs/mkdocs/site /flatcompose/site
